[{"address1": "501 - 3292 Production Way", "city": "Burnaby", "state": "BC", "zip": "V5A 4R4", "country": "Canada", "phone": "604 551 7831", "fax": "604 676 2767", "website": "https://cannabixtechnologies.com", "industry": "Medical Devices", "industryKey": "medical-devices", "industryDisp": "Medical Devices", "sector": "Healthcare", "sectorKey": "healthcare", "sectorDisp": "Healthcare", "longBusinessSummary": "Cannabix Technologies Inc. develops marijuana and alcohol breathalyzer technologies for law enforcement, workplaces, and laboratories in the United States. It offers Cannabix Marijuana Breath Test (MBT) system for tetrahydrocannabinol (THC) detection and quantification, which includes the Cannabix Breath Collection Unit (BCU) and Breath Cartridge (BC) for non-invasive, portable, standardized human breath sample collection, storage, and transportation. The company also provides BreathLogix, an autonomous alcohol screening system for rapid and repeatable high-volume screening in various employment settings. In addition, the company develops other TCH-detecting technologies, including mass spectrometer breath sampler (MSBS) technology, as well as high-field asymmetric waveform ion mobility spectrometry (FAIMS) and FAIMS-mass spectrometer systems. It has a strategic partnership and development agreement with Omega Laboratories Inc. for the development and commercialization of MBT technology. The company was formerly known as West Point Resources Inc. and changed its name to Cannabix Technologies Inc. in August 2014. Cannabix Technologies Inc. was incorporated in 2011 and is based in Burnaby, Canada.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Ravinder S. Mlait B.A., M.B.A.", "age": 49, "title": "CEO & Director", "yearBorn": 1976, "fiscalYear": 2025, "totalPay": 118104, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Bryan E. Loree B.A., C.M.A., CPA", "age": 49, "title": "CFO, Corporate Secretary & Director", "yearBorn": 1976, "fiscalYe