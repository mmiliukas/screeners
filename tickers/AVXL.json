[{"address1": "630 5th Avenue", "address2": "20th Floor", "city": "New York", "state": "NY", "zip": "10111", "country": "United States", "phone": "844 689 3939", "website": "https://www.anavex.com", "industry": "Biotechnology", "industryKey": "biotechnology", "industryDisp": "Biotechnology", "sector": "Healthcare", "sectorKey": "healthcare", "sectorDisp": "Healthcare", "longBusinessSummary": "Anavex Life Sciences Corp. operates as a biopharmaceutical company. It engages in developing innovative treatments for Alzheimer's disease, Parkinson's disease, schizophrenia, neurodevelopmental, neurodegenerative, and rare diseases, including Rett syndrome, and other central nervous system (CNS) disorders, pain, and various types of cancer. Its lead drug candidate, ANAVEX 2-73 (blarcamesine), which has completed a Phase 2a and a Phase 2b/3 clinical trial for Alzheimer's disease; a Phase 2 proof-of-concept study in Parkinson's disease dementia; and a Phase 2 and a Phase 3 study in adult patients and one Phase 2/3 study in pediatric patients with Rett syndrome. Its ANAVEX 2-73 is an orally available drug designed to restore cellular homeostasis by targeting SIGMAR1 and muscarinic receptors, as well as exhibits anticonvulsant, anti-amnesic, neuroprotective, and anti-depressant properties in animal models indicating its potential to treat additional CNS disorders, including epilepsy. The company's ANAVEX 3-71 that targets SIGMAR1 and M1 muscarinic receptors, which is a clinical stage drug candidate demonstrating disease-modifying activity against Alzheimer's disease in transgenic (3xTg-AD) mice, such as cognitive deficits, amyloid, and tau pathologies. Anavex Life Sciences Corp. was incorporated in 2004 and is headquartered in New York, New York.", "fullTimeEmployees": 34, "companyOfficers": [{"maxAge": 1, "name": "Ms. Sandra  Boenisch CPA, CGA", "age": 44, "title": "Principal Financial Officer & Treasurer", "yearBorn": 1981, "fiscalYear": 2025, "totalPay": 247070, "exercisedValue