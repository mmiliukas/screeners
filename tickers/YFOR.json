[{"address1": "60 Paya Lebar Road", "address2": "No. 09-13/14/15/16/17 Paya Lebar Square", "city": "Singapore", "zip": "409051", "country": "Singapore", "phone": "65 6604 6896", "website": "https://yyforce.ai", "industry": "Specialty Business Services", "industryKey": "specialty-business-services", "industryDisp": "Specialty Business Services", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "YYForce Inc., operates as a data and technology-driven company offering AI-enabled workforce management and integrated facility management (IFM) solutions in Singapore, Malaysia, the United Kingdom, the Netherlands, and internationally. The company's workforce management segment operates through the YY Circle platform, which provides workforce planning, scheduling, deployment, and operational optimization solutions for clients in the hospitality, food and beverage, retail, and other service-oriented industries. The platform utilizes data analytics and artificial intelligence capabilities to support labor forecasting and workforce allocation. The company's integrated facility management segment operates through its 24IFM software platform and related subsidiaries, providing facility management and operational support services across sectors, including hospitality, transportation, banking, retail, and mixed-use commercial properties. It offers workforce coordination, operational maintenance support, and facility-related management solutions. It offers the YY Smart iClean App, a smart toilet central management platform. It offers cleaning services that include commercial cleaning for offices and schools; hospitality cleaning for hotels and shopping centers; industrial cleaning, facade cleaning, disinfection, and stewarding services for meetings, incentives, conferences, and exhibitions, as well as banquets; and pest control services. It also provides cleaning robots and machines. It also offers IT consultancy and development of software and applications; residential, commercial, and industrial real estate management services; private security; and hospitality services. It also retails and distributes gaming peripherals and accessories. The company was formerly known as YY Group Holding Limited and changed its name to YYForce Inc. in September 2026. The company was founded in 2010 and is headquartered in Singapore.", "fullTimeEmployees": 1146, "companyOfficers": [{"maxAge": 1, "name": "Mr. Xiaowei  Fu", "age": 40, "title": "Founder, Chairman & CEO", "yearBorn": 1985, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Fan  Zhang", "age": 40, "title": "Co-Founder, Business Development Director & Executive Director", "yearBorn": 1985, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Zhi Yong  Phua", "age": 38, "title": "Chief Financial Officer", "yearBorn": 1987, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Leong Chin Yeo", "title": "Chief Operating Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Sin Ken  Teng", "age": 34, "title": "Chief Information Officer & Co-founder and Director of YY Circle Malaysia", "yearBorn": 1991, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Lin Pu  Xu", "age": 42, "title": "Chief Human Resource Officer", "yearBorn": 1983, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Wendou  Niu", "title": "Group Chief Strategy Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Alvin  Low", "title": "Head of the Integrated Facility Management (IFM) Division", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Eli  Yu", "title": "Chief Product Officer", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Nor  Salehati", "title": "Head of L&OD", "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 4, "previousC