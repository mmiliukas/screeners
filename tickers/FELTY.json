[{"address1": "Gate City Ohsaki, East Tower", "address2": "11-2, Osaki 1-chome Shinagawa-ku", "city": "Tokyo", "zip": "141-0032", "country": "Japan", "phone": "81 3 5435 7213", "website": "https://www.fujielectric.com", "industry": "Electrical Equipment & Parts", "industryKey": "electrical-equipment-parts", "industryDisp": "Electrical Equipment & Parts", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Fuji Electric Co., Ltd., together with its subsidiaries, develops power semiconductors and electronics solutions in Japan and internationally. The company operates through Energy, Industry, Semiconductors, and Food and Beverage Distribution segments. The company also offers drivers and controls including AC drives, motors, servo systems, programmable logic controllers, and human machine interface; power supply products, which includes uninterruptible power systems, solar inverters, data centers, regulators, rectifiers, and formers; sensors and measurements, such as instrumentation and radiation monitoring systems; and monitoring and control systems. In addition, it provides distribution and controls, including LV and MV distributions, motor controls, and energy control equipment; transmission and distribution comprising oil-immersed transformers, shunt reactors, cast resin transformers, gas insulated switchgears, MV and LV switchgears, and control centers; and transit systems, which includes tunnel ventilation systems, marine environment protection systems, and electrical equipment for railcars. Further, the company offers thermal and geothermal power generation, nuclear power, and fuel cell; energy management including power system simulator, steel EMS solutions, and boiler combustion solutions; can and PET, multi-purpose, frozen, and coffee machine; and transformers, AC drives, UPS, monitoring and control system upgrades solutions, as well as beverage vending machines, vending machines for food and other goods, store equipment, and currency handling equipment. Additionally, it offers ship and harbor systems, ICT equipment and software, and air conditioning equipment construction. Fuji Electric Co., Ltd. was formerly known as Fuji Electric Holdings Co., Ltd. and changed its name to Fuji Electric Co., Ltd. in 2011. Fuji Electric Co., Ltd. was incorporated in 1923 and is headquartered in Tokyo, Japan.", "fullTimeEmployees": 27419, "companyOfficers": [{"maxAge": 1, "name": "Mr. Michihiro  Kitazawa", "age": 73, "title": "CEO & Chairman", "yearBorn": 1952, "fiscalYear": 2026, "totalPay": 1229674, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1798675200, "irWebsite": "http://www.fujielectric.com/ir/index.html", "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 21.41, "open": 21.89, "dayLow": 21.8, "dayHigh": 21.95, "regularMarketPreviousClose": 21.41, "regularMarketOpen": 21.89, "regularMarketDayLow": 21.8, "regularMarketDayHigh": 21.95, "dividendRate": 0.32, "dividendYield": 1.44, "exDividendDate": 1774915200, "payoutRatio": 0.2943, "fiveYearAvgDividendYield": 1.81, "beta": 0.908, "trailingPE": 21.480392, "forwardPE": 0.45513088, "volume": 700, "regularMarketVolume": 700, "averageVolume": 38777, "averageVolume10days": 52520, "averageDailyVolume10Day": 52520, "bid": 21.91, "ask": 21.98, "bidSize": 441, "askSize": 200, "marketCap": 12794688512, "nonDilutedMarketCap": 13018024018, "fiftyTwoWeekLow": 14.58, "fiftyTwoWeekHigh": 27.96, "allTimeHigh": 27.96, "allTimeLow": 2.621875, "priceToSalesTrailing12Months": 0.010211749, "fiftyDayAverage": 21.5992, "twoHundredDayAverage": 19.4114, "trailingAnnualDividendRate": 200.0, "trailingAnnualDividendYield": 9.34143, "currency": "USD", "tradeable": false, "enterpriseValue": 47815688192, "profitMargins": 0.08604, "floatShares": 572759379, "sharesOutstanding": 583965680, "heldPercentInsiders": 0.0, "heldPercentInstitutions": 2.0000001e-05, "impliedSharesOutstanding": 583965680, "bookValue": 8