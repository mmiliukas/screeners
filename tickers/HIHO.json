[{"address1": "Landmark North", "address2": "Suite 1801 Level 18 39 Lung Sum Avenue", "city": "Sheung Shui", "country": "Hong Kong", "phone": "852 2344 4248", "fax": "852 2343 4976", "website": "https://www.highwayholdings.com", "industry": "Metal Fabrication", "industryKey": "metal-fabrication", "industryDisp": "Metal Fabrication", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Highway Holdings Limited, together with its subsidiaries, manufactures and sells metal, plastic, electric, and electronic parts and components, subassemblies, and finished products in Hong Kong, China, Europe, North America, and other Asian countries. The company operates through three segments: Metal Stamping and Mechanical Original Equipment Manufacturer (OEM); Electric OEM; and Other Services. Its products are used in the manufacture of products, such as photocopiers, laser printers, print cartridges, electrical connectors, electrical circuits, vacuum cleaners, LED power supplies, stepping motors, pumps for dishwashers, and other washing machine components. The company also provides manufacturing services, including metal stamping, screen printing, plastic injection molding, pad printing, and electronic assembly of printed circuit boards; and engineering services. In addition, it engages in the trading of plastic injection products; manufacturing and assembling of metal, plastics, mould and electronic products, and automation equipment; and provision of service to elderly people. The company offers its products to OEMs and contract manufacturers. Highway Holdings Limited was incorporated in 1990 and is headquartered in Sheung Shui, Hong Kong.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Roland Walter  Kohl", "age": 76, "title": "Founder, Chairman, CEO & President", "yearBorn": 1949, "fiscalYear": 2011, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Alan  Chan", "age": 62, "title": "CFO, Treasurer & Sec