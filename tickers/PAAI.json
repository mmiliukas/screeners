[{"address1": "200 Vesey Street", "address2": "24th Floor", "city": "New York", "state": "NY", "zip": "10281", "country": "United States", "phone": "212 321 5002", "website": "https://paradium.ai", "industry": "Internet Content & Information", "industryKey": "internet-content-information", "industryDisp": "Internet Content & Information", "sector": "Communication Services", "sectorKey": "communication-services", "sectorDisp": "Communication Services", "longBusinessSummary": "Paradium AI, Inc. operates an artificial intelligence technology platform for digital media, content creation, and monetization. The company operates through four segments: Sports & Leisure, Finance, Lifestyle, and Platform & Other. Its Sports & Leisure segment produces content on sports and leisure topics through media brands including Athlon Sports and the Adventure Sports Network, which includes Surfer, Powder, and Bike Magazine. The Finance segment produces content on finance topics through TheStreet. The Lifestyle segment produces content on lifestyle topics through brands including Parade, Men's Journal, and ShopHQ. The Platform & Other segment provides platform infrastructure and technology services, including Infosentience, a language engine for automated, data-driven natural language generation that converts structured data into content; Encore, a monetization and personalization engine that matches content, offers, and formats to audience members using first-party signals; a video and social production engine that converts long-form video and audio into cut-downs, captions, and posts for distribution across channels; and Cutter Studios, a content production offering. The company also offers a creator co-ownership platform across verticals including competition reality television, food and home content, and retail and restaurant consumer markets. It generates revenue from digital advertising, digital subscriptions, publisher revenue, performance marketing, other digital revenue, and print revenue. Paradium AI, Inc. was formerly known as The Arena Group Holdings, Inc. and changed its name to Paradium AI, Inc. in August 2026. Paradium AI, Inc. was incorporated in 1990 and is based in New York, New York. Paradium AI, Inc. operates as a subsidiary of Simplify Inventions, LLC.", "fullTimeEmployees": 159, "companyOfficers": [{"maxAge": 1, "name": "Mr. Paul Taylor Edmondson", "age": 50, "title": "Chief Executive Officer", "yearBorn": 1975, "fiscalYear": 2025, "totalPay": 706358, "exercisedValue": 0, "unexercisedValue": 1008000}], "auditRisk": 10, "boardRisk": 4, "compensationRisk": 7, "shareHolderRightsRisk": 6, "overallRisk": 7, "governanceEpochDate": 1788220800, "compensationAsOfEpochDate": 1767139200, "irWebsite": "http://www.robodoc.com", "executiveTeam": [], "maxAge": 86400, "priceHint": 4, "previousClose": 0.8999, "open": 0.93945, "dayLow": 0.9395, "dayHigh": 3.47, "regularMarketPreviousClose": 0.8999, "regularMarketOpen": 0.93945, "regularMarketDayLow": 0.9395, "regularMarketDayHigh": 3.47, "exDividendDate": 1565049600, "payoutRatio": 0.0, "beta": 0.945, "trailingPE": 17.578947, "forwardPE": 111.333336, "volume": 31758930, "regularMarketVolume": 31758930, "averageVolume": 946546, "averageVolume10days": 3442840, "averageDailyVolume10Day": 3442840, "bid": 3.22, "ask": 3.24, "bidSize": 500, "askSize": 300, "marketCap": 159019568, "nonDilutedMarketCap": 42844826, "fiftyTwoWeekLow": 0.81, "fiftyTwoWeekHigh": 7.13, "allTimeHigh": 66.0, "allTimeLow": 0.22, "fulldayPrice": 3.34, "fulldayChange": 2.4401, "fulldayChangePercent": 271.152, "priceToSalesTrailing12Months": 1.5808686, "fiftyDayAverage": 1.1478, "twoHundredDayAverage": 2.31455, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "USD", "tradeable": false, "enterpriseValue": 247732576, "profitMargins": 0.093100004, "floatShares": 13144349, "sharesOutstanding": 47610653, "sharesShort": 612080, "sharesShortPriorMonth": 457121, "sharesShortPreviousMonthDate": 1785456000