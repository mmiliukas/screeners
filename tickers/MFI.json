 digital assets. It serves financial institutions, including brokers, investment banks, institutional clients, liquidity providers, and financial services providers. The company was founded in 2002 and is headquartered in Central, Hong Kong.", "fullTimeEmployees": 33, "companyOfficers": [{"maxAge": 1, "name": "Mr. Dawei  Yuan", "age": 40, "title": "CEO & Executive Chairman", "yearBorn": 1985, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Yang  Liu", "age": 38, "title": "CFO, Chief Compliance Officer & Executive Director", "yearBorn": 1987, "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 2, "previousClose": 8.56, "open": 8.901, "dayLow": 8.9, "dayHigh": 15.0, "regularMarketPreviousClose": 8.56, "regularMarketOpen": 8.901, "regularMarketDayLow": 8.9, "regularMarketDayHigh": 15.0, "payoutRatio": 0.0, "beta": 7.043, "trailingPE": 5.6104646, "forwardPE": -39.87603, "volume": 335480, "regularMarketVolume": 335480, "averageVolume": 16546, "averageVolume10days": 39600, "averageDailyVolume10Day": 39600, "bid": 7.56, "ask": 11.95, "bidSize": 2, "askSize": 2, "marketCap": 484203040, "nonDilutedMarketCap": 468146604, "fiftyTwoWeekLow": 5.555, "fiftyTwoWeekHigh": 60.73, "allTimeHigh": 115.92, "allTimeLow": 4.048, "fulldayPrice": 9.4, "priceToSalesTrailing12Months": 14.315718, "fiftyDayAverage": 8.44, "twoHundredDayAverage": 12.781725, "trailingAnnualDividendRate": 0.0, "trailingAnnualDividendYield": 0.0, "currency": "USD", "tradeable": false, "enterpriseValue": 266603392, "profitMargins": 2.32813, "floatShares": 49045507, "sharesOutstanding": 49045623, "sharesShort": 36060, "sharesShortPriorMonth": 33992, "sharesShortPreviousMonthDate": 1782777600, "dateShortInterest": 1785456000, "sharesPercentSharesOut": 0.0007, "heldPercentInsiders": 0.0, "heldPercentInstitutions": 0.01026, "shortRatio": 4.41, "shortPercentOfFloat": 0.0007, "impliedSharesOutstanding": 50176485, "bookValue": 10.18962, "priceToBook": 0.9