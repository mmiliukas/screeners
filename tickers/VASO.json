 November 2016. Vaso Corporation was incorporated in 1987 and is headquartered in Plainview, New York.", "fullTimeEmployees": 282, "companyOfficers": [{"maxAge": 1, "name": "Dr. Jun  Ma Ph.D.", "age": 62, "title": "President, CEO & Director", "yearBorn": 1963, "fiscalYear": 2025, "totalPay": 807485, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Jonathan P. Newton", "age": 64, "title": "CFO, Treasurer & Secretary", "yearBorn": 1961, "fiscalYear": 2025, "totalPay": 418450, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Jane  Moen", "age": 44, "title": "President of VasoHealthcare, COO & Director", "yearBorn": 1981, "fiscalYear": 2025, "totalPay": 708712, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Michael J. Beecher CPA", "age": 80, "title": "Financial Advisor", "yearBorn": 1945, "fiscalYear": 2025, "totalPay": 149570, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Peter C. Castle", "age": 57, "title": "President of the VasoTechnology Inc", "yearBorn": 1968, "fiscalYear": 2025, "totalPay": 362000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Shen  Qiuming", "title": "President of Biox Instruments Co Ltd", "fiscalYear": 2025, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Randy  Hill", "age": 78, "title": "Consultant", "yearBorn": 1947, "fiscalYear": 2025, "totalPay": 105000, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Dr. Derek  Enlander M.D.", "age": 79, "title": "Advisor", "yearBorn": 1946, "fiscalYear": 2025, "totalPay": 12000, "exercisedValue": 0, "unexercisedValue": 0}], "compensationAsOfEpochDate": 1767139200, "irWebsite": "http://www.vasomedical.com/investors.php", "executiveTeam": [], "maxAge": 86400, "priceHint": 4, "previousClose": 0.19, "open": 0.2003, "dayLow": 0.2003, "dayHigh": 0.2794, "regularMarketPreviousClose": 0.19, "regularMarketOpen": 0.2003, "regularMarketDayLow": 0.200