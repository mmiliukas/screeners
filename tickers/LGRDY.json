[{"address1": "128, avenue du Mar\u00e9chal de Lattre de Tassigny", "city": "Limoges", "zip": "87045", "country": "France", "phone": "33 5 55 06 87 87", "fax": "33 5 55 06 88 88", "website": "https://www.legrand.com", "industry": "Electrical Equipment & Parts", "industryKey": "electrical-equipment-parts", "industryDisp": "Electrical Equipment & Parts", "sector": "Industrials", "sectorKey": "industrials", "sectorDisp": "Industrials", "longBusinessSummary": "Legrand SA, together with its subsidiaries, manufactures, distributes, and sells electrical and digital building infrastructures in Europe, North and Central America, and internationally. The company offers energy distribution, protection, and management solutions, such as electric vehicle charging, residential and small commercial panels, switchboards and power cabinets, and UPS devices; and wiring devices, connected home and building control solutions, and guestroom solutions, as well as flush-mounted, junction, DCL, and floor boxes. It also provides security, communication, and network solutions, including access security, digital home networks, emergency lighting, fire alarms, IT networks, intercom and door entry, and nurse call systems; conduits and cable management solutions comprising trunking, mini-trunking, skirting trunking, ducts, tubes, floor boxes, columns and feeders, and workstation solutions; industrial products, which comprises industrial enclosures and connections, transformers and power supply, marking accessories and cable ties, motor control and protection, fuse protection, and industrial plugs and sockets, as well as control, button, and signaling products; and installation accessories, including wiring accessories, extension cords, multi-outlet units, cable ties and fasteners, and connection boxes and terminals; and lighting products and accessories, as well as bulkhead lights and wall lights. In addition, the company offers single-phase UPS, three-phase UPS, communication accessories, software, and battery cabinets for three-phase UPS, as well as data center solutions. Further, it provides digital products and connected care services for health and social care sectors. The company also exports its products to approximately 180 countries. Legrand SA was founded in 1865 and is headquartered in Limoges, France.", "fullTimeEmployees": 40931, "companyOfficers": [{"maxAge": 1, "name": "Mr. Beno\u00eet  Coquart", "age": 52, "title": "CEO & Director", "yearBorn": 1973, "fiscalYear": 2024, "totalPay": 2264056, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Franck  Lemery", "age": 58, "title": "Executive VP & CFO", "yearBorn": 1967, "fiscalYear": 2024, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Blandine  Antoine", "title": "Executive Vice President of Products & Technology", "fiscalYear": 2024, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Ronan  Marc", "title": "Investor Relations Officer", "fiscalYear": 2024, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Benedicte  Bahier", "title": "Executive Vice President of Human Resources", "fiscalYear": 2024, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Frederic  Xerri", "age": 56, "title": "Executive Vice President of Europe", "yearBorn": 1969, "fiscalYear": 2024, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Jean-Luc  Cartet", "age": 58, "title": "Executive Vice President of Asia-Pacific, Middle East & Africa and South America", "yearBorn": 1967, "fiscalYear": 2024, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Ms. Virginie  Gatin", "age": 50, "title": "Executive Vice President of Corporate Social Responsibility", "yearBorn": 1975, "fiscalYear": 2024, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Brian  DiBella", "age": 52, "title": "President & CEO of Legrand North & Central America", "yearBorn": 1973, "fiscalYear