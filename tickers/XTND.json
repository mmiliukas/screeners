[{"address1": "5247 Crossroads Park Drive", "city": "Tampa", "state": "FL", "zip": "33610", "country": "United States", "phone": "813 621 8965", "website": "https://www.xtend.me", "industry": "Computer Hardware", "industryKey": "computer-hardware", "industryDisp": "Computer Hardware", "sector": "Technology", "sectorKey": "technology", "sectorDisp": "Technology", "longBusinessSummary": "Xtend AI Robotics, Inc. designs and develops artificial intelligence-powered robotics and autonomous systems for defense, homeland security, and commercial security applications. The company's core platform, XOS (XTEND Operating System), functions as a hardware-agnostic, AI-native mission execution operating system that connects autonomous platforms, AI applications, payloads, sensors, and third-party developers into a unified ecosystem. XOS provides AI Pilots software that learns skills and automates missions, a command-and-control interface for remote operation of multi-domain air and ground robotic systems, edge autonomy capabilities for GNSS-denied and confined-space environments, and an interoperability framework for integrating proprietary and third-party platforms, sensors, and payloads. The company also manufactures and sells aerial drones, ground robots, robotic subsystems, and related hardware components. Additionally, it operates a Marketplace that connects autonomous platforms, AI applications, payloads, sensors, and technology partners through XOS, along with a XTEND Certified program for partner products and technologies. The company provides system integration and customization services, including platform and software configuration for specific mission requirements, third-party sensor and payload integration, interoperability with customer systems, and operator and instructor training. It operates a global distributed manufacturing network known as XFAB, with production and operations inIsrael, the United States, Latvia, Singapore, Malaysia, and the United Kingdom. The company serves military end users, government agencies, defense prime contractors, law enforcement, homeland security organizations, and commercial security customers through firm fixed-price contracts, government-to-government procurement, defense prime partnerships, and direct sales and reseller channels. Xtend AI Robotics, Inc. was founded in 2018 and is based in Tampa, Florida.", "companyOfficers": [{"maxAge": 1, "name": "Mr. Aviv  Shapira", "age": 44, "title": "Co-Founder, CEO & Director", "yearBorn": 1981, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Matteo  Shapira", "age": 45, "title": "Co-Founder & Chief AI Officer", "yearBorn": 1980, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Reuven  Liani", "age": 38, "title": "Co-Founder, CTO & Director", "yearBorn": 1987, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Adir  Tubi", "title": "Co-Founder", "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Tal  Horesh", "age": 40, "title": "CFO & Head of Corporate Development", "yearBorn": 1985, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Amir  Ofri", "age": 46, "title": "Chief Operating Officer", "yearBorn": 1979, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Mor  Swiel", "age": 54, "title": "Chief Legal Officer", "yearBorn": 1971, "exercisedValue": 0, "unexercisedValue": 0}, {"maxAge": 1, "name": "Mr. Joseph Frank Basile III", "age": 46, "title": "Executive Vice President of Construction Operations", "yearBorn": 1979, "exercisedValue": 0, "unexercisedValue": 0}], "executiveTeam": [], "maxAge": 86400, "priceHint": 4, "previousClose": 1.77, "open": 1.78, "dayLow": 1.7, "dayHigh": 3.05, "regularMarketPreviousClose": 1.77, "regularMarketOpen": 1.78, "regularMarketDayLow": 1.7, "regularMarketDayHigh": 3.05, "dividendYield": 0.0, "volume": 22566068, "regularMarketVolume": 22566068, "averageVolume": 1167080, "averageVolume1